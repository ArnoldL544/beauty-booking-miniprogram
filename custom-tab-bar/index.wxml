<view class="tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'tab-selected' : ''}} {{index === 2 ? 'tab-center' : ''}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <block wx:if="{{index === 2}}">
      <view class="booking-circle">
        <text class="booking-symbol">＋</text>
      </view>
      <text class="tab-label center-label">{{item.label}}</text>
    </block>
    <block wx:else>
      <image class="tab-icon" src="/assets/tabbar/{{item.icon}}-{{selected === index ? 'active' : 'normal'}}.png" mode="aspectFit" />
      <text class="tab-label">{{item.label}}</text>
    </block>
  </view>
</view>
