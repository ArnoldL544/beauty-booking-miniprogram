<view class="mine-page">
  <view class="profile-card" bindtap="goProfile">
    <view class="avatar">
    </view>
    <view class="profile-main">
      <view class="profile-name">微信用户</view>
      <view class="profile-hint">个人资料与账户信息 · 待完善</view>
    </view>
    <text class="arrow">›</text>
  </view>
  <view class="module-card">
    <view class="module-header" data-status="all" bindtap="goOrders">
      <text class="module-title">我的订单</text>
      <text class="header-action">仅护肤品订单　查看全部 ›</text>
    </view>
    <view class="order-nav">
      <view wx:for="{{orderShortcuts}}" wx:key="status" class="order-nav-item" data-status="{{item.status}}" bindtap="goOrders">
        <view class="order-dot">
          <image class="order-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <text class="order-label">{{item.name}}</text>
      </view>
    </view>
  </view>
  <view class="module-card menu-card">
    <view class="menu-row" wx:for="{{entries}}" wx:key="name" data-url="{{item.url}}" bindtap="openEntry">
      <view class="menu-icon">{{item.icon}}</view>
      <view class="menu-copy">
        <text class="menu-name">{{item.name}}</text><text class="menu-tip">{{item.tip}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
  <view class="page-footnote">美容项目的预约记录请到下方「预约详情」查看</view>
</view>
