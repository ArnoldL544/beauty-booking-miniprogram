.mine-page {
  padding: 30rpx 42rpx 175rpx;
  box-sizing: border-box;
}
.profile-card,
.module-card {
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 5rpx 16rpx rgba(0, 0, 0, 0.035);
  margin-bottom: 24rpx;
}
.profile-card {
  display: flex;
  align-items: center;
  padding: 36rpx 28rpx;
  gap: 24rpx;
}
.avatar {
  height: 108rpx;
  width: 108rpx;
  background: #f7e9ed;
  color: #b78493;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 43rpx;
}
.profile-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.profile-name {
  font-size: 36rpx;
  font-weight: 650;
}
.profile-hint,
.menu-tip,
.header-action {
  font-size: 23rpx;
  color: #999;
}
.arrow {
  color: #b3a5a5;
  font-size: 42rpx;
}
.module-header {
  padding: 27rpx 26rpx 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.module-title {
  font-size: 31rpx;
  font-weight: 650;
}
.header-action {
  font-size: 23rpx;
}
.order-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 20rpx 30rpx;
}
.order-nav-item {
  flex: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 14rpx;
}
.order-dot {
  border-radius: 15rpx;
  width: 72rpx;
  height: 72rpx;
  background: #fff1f2;
  color: #ce6c7a;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
}
.order-label {
  font-size: 23rpx;
  color: #656565;
}
.menu-card {
  padding: 0 22rpx;
}
.menu-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 1rpx solid #f4f0f0;
  gap: 17rpx;
}
.menu-row:last-child {
  border-bottom: 0;
}
.menu-icon {
  width: 56rpx;
  color: #bf8691;
  font-size: 36rpx;
  text-align: center;
}
.menu-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}
.menu-name {
  font-size: 29rpx;
  font-weight: 500;
  color: #333;
}
.page-footnote {
  font-size: 23rpx;
  color: #a49b9b;
  text-align: center;
  line-height: 1.6;
  padding-top: 8rpx;
}

.order-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
}
