.page {
  padding: 30rpx 48rpx 170rpx;
}
.page-title {
  font-size: 42rpx;
  text-align: center;
  font-weight: 600;
  margin: 12rpx 0 34rpx;
}
.service-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}
.service-card {
  background: #fff;
  overflow: hidden;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.055);
}
.service-photo {
  display: block;
  width: 100%;
  height: 320rpx;
}
.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
}
.service-name {
  font-size: 34rpx;
  font-weight: 600;
}
.service-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}
.arrow {
  font-size: 44rpx;
  color: #aaa;
}
.page-hint {
  color: #999;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
  margin-top: 36rpx;
}

.service-meta {
  flex: 1;
}
.service-price {
  font-size: 27rpx;
  color: #e64340;
  margin-top: 10rpx;
}
