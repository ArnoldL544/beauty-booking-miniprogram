<view class="products-page">
  <view class="product-list">
    <view class="product-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct">
      <image wx:if="{{item.cover}}" class="product-cover" src="{{item.cover}}" mode="aspectFit" lazy-load="{{false}}" />
      <view wx:else class="product-cover product-cover-placeholder">
        <text class="placeholder-title">{{item.name}}</text>
        <text class="placeholder-hint">商品海报待添加</text>
      </view>
      <view class="product-info">
        <view class="product-left">
          <text class="product-name">{{item.name}}</text>
          <text wx:if="{{item.brand}}" class="product-brand">{{item.brand}}</text>
        </view>
        <view class="product-right">
          <view class="price-wrapper">
            <text class="product-price">{{item.priceText}}</text><text wx:if="{{item.priceSource}}" class="price-caption">{{item.priceSource}}</text>
          </view>
          <text class="product-arrow">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
