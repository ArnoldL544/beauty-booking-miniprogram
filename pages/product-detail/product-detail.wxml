<view wx:if="{{product}}" class="product-detail-page">
  <view class="header">
    <view class="name">{{product.name}}</view>
    <view wx:if="{{product.brand}}" class="brand">品牌：{{product.brand}}</view>
    <view class="price">{{product.priceText}}</view>
    <view wx:if="{{product.priceSource}}" class="price-notice">来源：商品页截图，正式销售价格待商家确认</view>
    <view class="favorite-line" bindtap="toggleFavorite">
      <text class="favorite-heart">{{isFavorite ? "♥" : "♡"}}</text><text>{{isFavorite ? "已收藏" : "收藏该商品"}}</text>
    </view>
  </view>

  <!-- Show the product details first, then images; show "coming soon" when there are no details. -->
  <view class="section">
    <view class="section-title">产品功能介绍</view>
    <view wx:if="{{product.description}}" class="description">{{product.description}}</view>
    <view wx:else class="description-placeholder">产品功能介绍待补充</view>
  </view>

  <view class="section">
    <view class="section-title">产品图片</view>
    <view wx:if="{{product.images.length > 0}}" class="gallery">
      <image wx:for="{{product.images}}" wx:key="*this" class="gallery-image"
        src="{{item}}" mode="widthFix" data-src="{{item}}" bindtap="previewImage" lazy-load />
    </view>
    <view wx:else class="gallery-placeholder">商品图片待添加</view>
  </view>

  <view class="bottom-action">
    <button class="contact-button" bindtap="contactSeller">联系商家购买</button>
  </view>
</view>
