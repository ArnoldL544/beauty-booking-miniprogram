}
.intro {
  margin: 8rpx 0 28rpx;
}
.intro-title {
  font-size: 39rpx;
  font-weight: 700;
}
.intro-small {
  color: #aaa;
  font-size: 25rpx;
  margin-top: 11rpx;
}
