.page {
  padding: 40rpx 48rpx 180rpx;
  box-sizing: border-box;
}
.page-title {
  font-size: 44rpx;
  font-weight: 600;
  text-align: center;
  margin: 6rpx 0 38rpx;
}
.category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 26rpx;
}
.category-card {
  width: calc(50% - 13rpx);
  box-sizing: border-box;
  overflow: hidden;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.055);
}
.category-image {
  width: 100%;
  height: 218rpx;
  display: block;
}
.category-label {
  text-align: center;
  padding: 20rpx 10rpx 24rpx;
  font-size: 31rpx;
  font-weight: 600;
}
.hint {
  margin-top: 40rpx;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}
