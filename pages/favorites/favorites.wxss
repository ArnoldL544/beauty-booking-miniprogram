.fav-page {
  padding: 30rpx 42rpx 140rpx;
}
.fav-title {
  font-size: 40rpx;
  font-weight: 700;
}
.fav-caption {
  font-size: 24rpx;
  color: #999;
  margin: 10rpx 0 25rpx;
}
.fav-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 25rpx;
}
.fav-tab {
  font-size: 26rpx;
  border-radius: 40rpx;
  padding: 16rpx 22rpx;
  background: #fff;
  color: #777;
}
.fav-tab.selected {
  background: #e64340;
  color: #fff;
}
.fav-empty {
  border-radius: 22rpx;
  background: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 65rpx 37rpx;
}
.heart {
  font-size: 86rpx;
  color: #d9a3aa;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 15rpx;
}
.empty-info,
.foot {
  color: #999;
  font-size: 25rpx;
  line-height: 1.7;
  text-align: center;
}
.foot {
  margin-top: 28rpx;
  font-size: 22rpx;
}
.fav-card {
  background: #fff;
  padding: 19rpx;
  border-radius: 16rpx;
  margin-bottom: 17rpx;
}
.fav-main {
  display: flex;
  gap: 22rpx;
}
.cover {
  width: 145rpx;
  height: 145rpx;
  border-radius: 12rpx;
  background: #f6eeee;
  flex-shrink: 0;
}
.no-cover {
  color: #cf9da7;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 7rpx;
}
.name {
  font-size: 28rpx;
  font-weight: 600;
}
.sub {
  font-size: 23rpx;
  color: #999;
}
.view {
  font-size: 22rpx;
  color: #dd686f;
}
.remove {
  text-align: right;
  color: #a88b8b;
  font-size: 22rpx;
  padding: 17rpx 8rpx 2rpx;
}
